[Unit]
# Legacy schedule: keep disabled; full-sync.service is used by page/manual refresh.
Description=Run MaxNow ballet full reconciliation monthly at 00:47 Asia/Shanghai

[Timer]
OnCalendar=*-*-01 00:47:00 Asia/Shanghai
Persistent=true
AccuracySec=30s
RandomizedDelaySec=0
Unit=maxnow-ballet-full-sync.service

[Install]
WantedBy=timers.target
