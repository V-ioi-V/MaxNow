[Unit]
Description=MaxNow Ballet dynamic weekly closeout refresh
Documentation=file:/var/www/maxnow-dashboard/SERVER_RUNBOOK.md
After=maxnow-ballet-sync.service
ConditionPathExists=/etc/maxnow-ballet/enable-sync

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/maxnow-dashboard
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=maxnow-ballet-week-closeout
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -B scripts/ballet_week_closeout.py --model /var/www/maxnow-dashboard/dash/data/ballet.json --state /var/lib/maxnow-ballet-week-closeout/state.json
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/maxnow-ballet-week-closeout
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
