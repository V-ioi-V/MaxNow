// The refresh broker may only start the existing read-only full-sync unit.
polkit.addRule(function(action, subject) {
    if (subject.user === "maxnow-ballet-refresh" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "maxnow-ballet-full-sync.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
