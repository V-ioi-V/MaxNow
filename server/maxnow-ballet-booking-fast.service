[Unit]
Description=MaxNow Sunday ballet booking fast path
Documentation=file:/var/www/maxnow-dashboard/SERVER_RUNBOOK.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/maxnow-ballet/enable-fast-booking

[Service]
Type=oneshot
User=root
Group=www-data
WorkingDirectory=/var/www/maxnow-dashboard
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredentialEncrypted=wenda-session.json:/etc/credstore.encrypted/maxnow-ballet-wenda.cred
RuntimeDirectory=maxnow-ballet-booking-fast
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/maxnow-ballet-booking-fast
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g www-data /var/lib/maxnow-ballet-booking-fast-public
ExecStart=/usr/bin/flock --nonblock /run/maxnow-ballet-booking-fast/run.lock /usr/bin/python3 -B scripts/book_ballet_fast.py execute
TimeoutStartSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/maxnow-ballet-booking-fast
ReadWritePaths=/var/lib/maxnow-ballet-booking-fast-public
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

