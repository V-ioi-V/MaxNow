[Unit]
Description=Run MaxNow ballet rolling sync daily and after Sunday timetable publish

[Timer]
OnCalendar=*-*-* 00:00:00 Asia/Shanghai
OnCalendar=Sun *-*-* 14:20:00 Asia/Shanghai
Persistent=true
AccuracySec=30s
RandomizedDelaySec=0
Unit=maxnow-ballet-sync.service

[Install]
WantedBy=timers.target
