[Unit]
Description=MaxNow redacted Wenda session experiment status publisher
Documentation=file:/var/www/maxnow-dashboard/SERVER_RUNBOOK.md
After=local-fs.target
ConditionPathExists=/etc/maxnow-ballet/session-experiment.json

[Service]
Type=oneshot
User=maxnow-ballet-status
Group=maxnow-ballet-status
WorkingDirectory=/
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -r /etc/maxnow-ballet/session-experiment.json
ExecStartPre=/usr/bin/test ! -r /etc/credstore.encrypted/maxnow-ballet-wenda.cred
ExecStartPre=/usr/bin/test ! -r /run/credentials
ExecStart=/usr/bin/python3 -B /usr/local/lib/maxnow-ballet-session-status/sync_ballet_session_status.py --config /etc/maxnow-ballet/session-experiment.json --output /var/lib/maxnow-ballet-session-status/public/ballet-session.json --wrapper /var/lib/maxnow-ballet-session-status/public/ballet-session.js
TimeoutStartSec=30
UMask=0022
StateDirectory=maxnow-ballet-session-status
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/maxnow-ballet-session-status/source
ReadOnlyPaths=/etc/maxnow-ballet/session-experiment.json
ReadOnlyPaths=/usr/local/lib/maxnow-ballet-session-status/sync_ballet_session_status.py
ReadWritePaths=/var/lib/maxnow-ballet-session-status
InaccessiblePaths=-/run/credentials -/etc/credstore.encrypted
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap
IPAddressDeny=any
